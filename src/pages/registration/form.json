{
  "$schema": "./form-schema.schema.json",
  "version": "1.0",
  "root": {
      "component": "$component(Card)",
      "componentProps": {
        "className": "space-y-6"
      },
      "children": [
        {
          "component": "$html(div)",
          "componentProps": {
            "className": "space-y-4"
          },
          "children": [
            {
              "selector": "name",
              "value": "$model(name)",
              "component": "$component(Textbox)",
              "componentProps": {
                "label": "Имя"
              }
            },
            {
              "selector": "email",
              "value": "$model(email)",
              "component": "$component(Textbox)",
              "componentProps": {
                "label": "Email",
                "type": "email"
              }
            }
          ]
        }
      ]
    }
}
